# --- Slack (Socket Mode; see docs/SLACK_APP.md for the manifest) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# optional: comma-separated channel ids where passive features (memory recall, auto-suggest) may act; empty = everywhere the bot is
WATCH_CHANNELS=

# --- LLM (OpenAI; leave empty to run with the deterministic FakeProvider) ---
OPENAI_API_KEY=sk-...
LLM_MODEL_FAST=gpt-5.4-mini
LLM_MODEL_SMART=gpt-5.4
LLM_REASONING_EFFORT=low

# --- plugins: each disables itself when its key is empty ---
EXA_KEY=
# one Atlassian account for Jira + Confluence (https://id.atlassian.com/manage-profile/security/api-tokens, unscoped token)
ATLASSIAN_EMAIL=
ATLASSIAN_TOKEN=
JIRA_BASE_URL=https://<site>.atlassian.net
JIRA_PROJECT_KEY=
CONFLUENCE_SPACE_KEY=
CONFLUENCE_PARENT_PAGE_ID=
# per-product overrides (optional): CONFLUENCE_BASE_URL, CONFLUENCE_EMAIL, CONFLUENCE_API_TOKEN, JIRA_EMAIL, JIRA_API_TOKEN
SLACK_CANVAS_ENABLED=false

# --- behaviour ---
QUORUM_LANG=en             # chrome language of the card: en | ru (content follows the thread language)
TIMEZONE=Asia/Tashkent
COALESCE_SECONDS=4
SILENCE_MINUTES=30
SILENCE_MESSAGES=5
STALL_HOURS=6
EXPIRE_HOURS=48
AUTOSUGGEST_EVERY_N=8
SCHEDULER_TICK_SECONDS=20
DEMO_TIME_SCALE=1          # 60 => timers run 60x faster (a "30 min" silence fires after 30 s)
DEMO_PERSONAS=             # e.g. Ann,Bob,Cid — seeded demo messages posted under these names count as humans
DB_PATH=data/quorum.db
LOG_LEVEL=INFO
