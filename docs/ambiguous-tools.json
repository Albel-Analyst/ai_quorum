    {
      "name": "list_tasks",
      "title": "List tasks",
      "description": "List tasks in the workspace. Pass assignee_id to filter by assignee (use the caller's user ID for 'my tasks'). Supports filtering by status, priority, project, and free-text query.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "assignee_id": {
            "description": "Filter to tasks assigned to this user. `unassigned` to filter to unassigned.",
            "type": "string"
          },
          "creator_id": {
            "description": "Filter by creator user ID.",
            "type": "string"
          },
          "status": {
            "description": "Filter by system status. Comma-separated for multi-select.",
            "type": "string"
          },
          "task_status_id": {
            "description": "Filter by custom status ID.",
            "type": "string"
          },
          "exclude_task_status_ids": {
            "description": "Comma-separated custom status IDs to exclude.",
            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "project_id": {
            "type": "string"
          },
          "parent_task_id": {
            "description": "Filter by parent task ID. Special value `null` (string) returns top-level tasks only.",
            "type": "string"
          },
          "due_date_start": {
            "description": "YYYY-MM-DD lower bound (inclusive).",
            "type": "string"
          },
          "due_date_end": {
            "description": "YYYY-MM-DD upper bound (inclusive).",
            "type": "string"
          },
          "has_due_date": {
            "description": "Pass 'true' to filter to tasks with a due date set.",
            "type": "string",
            "enum": [
              "true",
              "false"
            ]
          },
          "start_date_from": {
            "type": "string"
          },
          "start_date_to": {
            "type": "string"
          },
          "q": {
            "description": "Free-text search across title + description.",
            "type": "string"
          },
          "completed_min": {
            "description": "ISO 8601 lower bound on `completed_at`.",
            "type": "string"
          },
          "completed_max": {
            "description": "ISO 8601 upper bound on `completed_at`.",
            "type": "string"
          },
          "updated_min": {
            "description": "ISO 8601 lower bound on `updated_at`.",
            "type": "string"
          },
          "cycle_id": {
            "description": "Filter by cycle ID. `none` returns tasks with no cycle.",
            "type": "string"
          },
          "label_id": {
            "description": "Filter by a single label ID (must be a UUID).",
            "type": "string"
          },
          "label_ids": {
            "description": "Comma-separated label IDs (AND match).",
            "type": "string"
          },
          "any_label_ids": {
            "description": "Comma-separated label IDs (OR match).",
            "type": "string"
          },
          "contact_id": {
            "description": "Filter to tasks linked to this CRM contact.",
            "type": "string"
          },
          "deal_id": {
            "description": "Filter to tasks linked to this CRM deal.",
            "type": "string"
          },
          "subscribed": {
            "description": "Pass 'me' to filter to tasks the caller is subscribed to.",
            "type": "string"
          },
          "managed_coworkers": {
            "description": "Pass 'true' to filter to tasks assigned to AI coworkers managed by the caller.",
            "type": "string"
          },
          "show_archived": {
            "description": "Pass 'true' to include archived tasks (default: hidden).",
            "type": "string",
            "enum": [
              "true",
              "false"
            ]
          },
          "untriaged": {
            "description": "Pass 'true' to filter to tasks with no project_id.",
            "type": "string",
            "enum": [
              "true",
              "false"
            ]
          },
          "hide_blocked": {
            "description": "Pass 'true' to filter out tasks blocked via task_relations.",
            "type": "string",
            "enum": [
              "true",
              "false"
            ]
          },
          "sort": {
            "type": "string",
            "enum": [
              "updated_at",
              "sort_order",
              "created_at",
              "due_date",
              "priority"
            ]
          },
          "cursor": {
            "description": "Opaque cursor from a prior `next_cursor`.",
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "max_results": {
            "description": "Alias for `limit`.",
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "offset": {
            "description": "Offset-based pagination fallback.",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "fields": {
            "type": "string"
          },
          "notify": {
            "type": "string"
          }
        },
        "additionalProperties": false
